#!/bin/sh
# VNEXIFY Creator OS Git Pre-Commit Hook

echo "=========================================="
echo "    VNEXIFY Git Hook: Pre-Commit Scan     "
echo "=========================================="

powershell -ExecutionPolicy Bypass -File "./scripts/security_scan.ps1"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "             COMMIT BLOCKED               "
    echo "Secret detected in staged or local source."
    echo "Remove the secret before committing."
    echo "=========================================="
    exit 1
fi

exit 0
