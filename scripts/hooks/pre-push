#!/bin/sh
# VNEXIFY Creator OS Git Pre-Push Hook

echo "=========================================="
echo "     VNEXIFY Git Hook: Pre-Push Gate      "
echo "=========================================="

powershell -ExecutionPolicy Bypass -File "./scripts/pre_release_check.ps1"
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "=========================================="
    echo "              PUSH BLOCKED                "
    echo "Project failed pre-release verification."
    echo "=========================================="
    exit 1
fi

exit 0
